        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.66;" edge="1" parent="1" source="syncfail" target="search">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="305" y="900" />

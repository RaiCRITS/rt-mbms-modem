          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="715" />
              <mxPoint x="630" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="sì" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dfound" target="foundbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="foundbox" target="sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="sync" target="dsync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dsync" target="syncfail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="695" />
              <mxPoint x="660" y="900" />
            </Array>
          </mxGeometry>

        <mxCell id="e8" value="no (scan attivo)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="dstep" target="exhausted">
          <mxGeometry relative="1" as="geometry">

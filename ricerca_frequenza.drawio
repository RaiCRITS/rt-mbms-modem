        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.33;" edge="1" parent="1" source="lost" target="search">
          <mxGeometry relative="1" as="geometry">
